# ========================================
# API Keys (REQUIRED)
# ========================================

# Google API Key (for ADK agents: Orchestrator, Budget, Restaurant, Weather, Coach)
# Get your key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# OpenAI API Key (for LangGraph agents: Itinerary)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Configuration (for Database Agents)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Deriv Configuration (for Trading Data)
DERIV_TOKEN=your_deriv_api_token_here
DERIV_APP_ID=your_deriv_app_id_here
DEMO_USER_ID=your_demo_user_id_here

# CopilotKit API Key (for Frontend Integration)
NEXT_PUBLIC_COPILOT_CLOUD_API_KEY=your_copilotkit_public_key_here

# ========================================
# Agent URLs (Frontend -> Agents)
# Default Configuration
# ========================================

# Orchestrator (ADK + AG-UI Protocol)
ORCHESTRATOR_URL=http://localhost:9000

# LangGraph Agents (Python + OpenAI + A2A Protocol)
ITINERARY_AGENT_URL=http://localhost:9001
RESTAURANT_AGENT_URL=http://localhost:9003

# ADK Agents (Python + Gemini + A2A Protocol)
BUDGET_AGENT_URL=http://localhost:9002
WEATHER_AGENT_URL=http://localhost:9005
MARKET_AGENT_URL=http://localhost:9020
NEWS_AGENT_URL=http://localhost:9021
SENTIMENT_AGENT_URL=http://localhost:9022
MERGE_AGENT_URL=http://localhost:9023
BEHAVIOR_AGENT_URL=http://localhost:9025
COACH_AGENT_URL=http://localhost:9026

# ========================================
# Agent Ports (Python Agents)
# Default Ports
# ========================================

# Orchestrator
ORCHESTRATOR_PORT=9000

# Specialized Agents
ITINERARY_PORT=9001
RESTAURANT_PORT=9003
BUDGET_PORT=9002
WEATHER_PORT=9005
MARKET_AGENT_PORT=9020
NEWS_AGENT_PORT=9021
SENTIMENT_AGENT_PORT=9022
MERGE_AGENT_PORT=9023
BEHAVIOR_AGENT_PORT=9025
COACH_AGENT_PORT=9026
