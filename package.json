{
  "name": "trading-agents",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --names \"UI,Orch,Market,News,Sent,Merge,Behav,Coach,Screen\" --prefix-colors \"cyan,gray,magenta,magenta,yellow,white,red,purple,blue\" \"npm run dev:ui\" \"npm run dev:orchestrator\" \"npm run dev:market\" \"npm run dev:news\" \"npm run dev:sentiment\" \"npm run dev:merge\" \"npm run dev:behavior\" \"npm run dev:coach\" \"npm run dev:screen\"",
    "dev:ui": "next dev --turbopack",
    "dev:orchestrator": "agents\\.venv\\Scripts\\python agents/orchestrator.py",
    "dev:market": "agents\\.venv\\Scripts\\python agents/market_analysis_agent.py",
    "dev:news": "agents\\.venv\\Scripts\\python agents/news_agent.py",
    "dev:sentiment": "agents\\.venv\\Scripts\\python agents/sentiment_agent.py",
    "dev:merge": "agents\\.venv\\Scripts\\python agents/merge_agent.py",
    "dev:itinerary": "agents\\.venv\\Scripts\\python agents/itinerary_agent.py",
    "dev:budget": "agents\\.venv\\Scripts\\python agents/budget_agent.py",
    "dev:restaurant": "agents\\.venv\\Scripts\\python agents/restaurant_agent.py",
    "dev:weather": "agents\\.venv\\Scripts\\python agents/weather_agent.py",
    "dev:behavior": "agents\\.venv\\Scripts\\python agents/behavior_agent.py",
    "dev:coach": "agents\\.venv\\Scripts\\python agents/coach_agent.py",
    "dev:screen": "agents\\.venv\\Scripts\\python -m uvicorn screen_server:app --host 0.0.0.0 --port 9055 --app-dir agents",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@a2a-js/sdk": "latest",
    "@ag-ui/a2a-middleware": "0.0.2",
    "@ag-ui/client": "0.0.40",
    "@copilotkit/react-core": "latest",
    "@copilotkit/react-ui": "latest",
    "@copilotkit/runtime": "latest",
    "@heroicons/react": "^2.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@supabase/supabase-js": "^2.95.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dedent": "^1.7.0",
    "lucide-react": "^0.477.0",
    "next": "15.1.6",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "technicalindicators": "^3.1.0",
    "yahoo-finance2": "^3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "eslint": "^8",
    "eslint-config-next": "15.1.6",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "@ag-ui/client": "0.0.40"
  }
}
